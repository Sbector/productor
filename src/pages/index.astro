---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';
import HomeNav from '../components/HomeNav.astro';
import AboutSection from '../components/AboutSection.astro';
import ProyectosSection from '../components/ProyectosSection.astro';
import SocialCard from '../components/SocialCard.astro';
---

<Layout title="sbector: Productor de arte contemporáneo y programador creativo">
  <div
    id="home"
    class="relative snap-y scroll-smooth snap-mandatory h-screen overflow-y-scroll no-scrollbar"
  >
    <Video />
    <HomeNav />
    <AboutSection />
    <ProyectosSection />
    <SocialCard />
  </div>
</Layout>
