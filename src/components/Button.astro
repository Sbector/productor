---
interface Props {
  href: string;
  target?: string;
  class?: string;
}

const { href, target, class: className = '' } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class={`w-auto bg-gray-800
  hover:bg-green-500 hover:text-black
  px-2 py-1
  ${className}`}
>
  <slot />
</a>
