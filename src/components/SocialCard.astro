---
import Wrapper from './Wrapper.astro';
import SocialPill from './SocialPill.astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import MailIcon from './icons/MailIcon.astro';
---

<Wrapper>
  <div
    id="contacto"
    class="py-20 mx-10
    md:w-[700px] md:mx-auto
    lg:w-[820px]
    xl:w-[1024px]"
  >
    <h2
      class="text-lg text-green-300 font-semibold uppercase pb-6
      md:text-3xl md:pb-10"
    >
      Contáctame
    </h2>
    <nav class="flex flex-wrap gap-2 md:gap-4 h-auto">
      <SocialPill href="mailto:sbector.prod@gmail.com">
        <MailIcon class="w-4 h-4" />e-mail
      </SocialPill>
      <SocialPill href="https://www.linkedin.com/in/saul-becerra-torres">
        <LinkedinIcon class="w-4 h-4" />Linkedin
      </SocialPill>
      <SocialPill href="https://github.com/Sbector">
        <GithubIcon class="w-4 h-4" />Github
      </SocialPill>
    </nav>
  </div>
</Wrapper>
